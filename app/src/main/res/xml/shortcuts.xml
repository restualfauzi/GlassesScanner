<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="start_radar"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/nav_scanner"
        android:shortcutLongLabel="@string/shortcut_radar_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.glassesscan.app"
            android:targetClass="com.glassesscan.app.MainActivity"
            android:data="shortcut://radar" />
    </shortcut>
    <shortcut
        android:shortcutId="open_ai_scan"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/nav_visual"
        android:shortcutLongLabel="@string/shortcut_visual_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.glassesscan.app"
            android:targetClass="com.glassesscan.app.MainActivity"
            android:data="shortcut://visual" />
    </shortcut>
</shortcuts>
